class Solution(object):
    def sortList(self, head):
        l = 0
        n  = len(head)-1
        r = 1
        while r <= n :
            if head[r]>head[l]:
                head[l] = head[r]
                l+=1
            else:
                r+=1
        return head
                
head = [4,2,1,3]
print(Solution().sortList(head))