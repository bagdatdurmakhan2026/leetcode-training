class Solution(object):
    def ans(self, s):
        n = len(s)
        start = 0 
        mx = 0 
        for i in range(n):
            l = i
            r = i
            while l >= 0 and r <n and s[l]==s[r]:
                curr_s = r-l+1
                if curr_s> mx :
                    mx = curr_s
                    start = l
                l-=1
                r+=1
            l = i
            r = i +1
            while l >= 0 and r <n and s[l]==s[r]:
                curr_s = r-l+1
                if curr_s> mx :
                    mx = curr_s
                    start = l
                l-=1
                r+=1
        res =""
        for j in range(start, start+mx):
            res+=s[j]
        return res       
s = "babad"
print(Solution().ans(s))